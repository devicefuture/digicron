extload csv

DATA_PATH$ = "/data/devicefuture/counter/counters.csv"

ACTION_NONE = 0
ACTION_INCREMENT = 1
ACTION_DECREMENT = 2
ACTION_SET_VALUE = 3
ACTION_RESET = 4
ACTION_SET_RESET_VALUE = 5

dim counters with name$, value, base, resetValue, selectAction, selectArg, upAction, upArg, downAction, downArg

if exists(DATA_PATH$)
    open DATA_PATH$, file, "r"
    read file, csvData$
    csv.intolist csvData$, counters
    close file
end

currentCounter = 0

def saveCounters
    open DATA_PATH$, file, "w"
    csv.fromlist counters, csvData$
    write csvData$, file
    close file
end

def newCounter name$, value
    push name$, value, 10, 0, ACTION_INCREMENT, 1, ACTION_INCREMENT, 1, ACTION_DECREMENT, 1, counters

    currentCounter = len(counters) - 1

    saveCounters
end

def renderCounter
    cls
    scroll counters[currentCounter].name$

    base = counters[currentCounter].base
    value = counters[currentCounter].value
    displayValue$ = ""

    while base != 10 and value < 0
        value = value + (base ^ cols)
    loop

    if base = 2
        displayValue$ = lpad$(bin$(value), 8, "0")
    else if base = 8
        displayValue$ = lpad$(oct$(value), 8, "0")
    else if base = 16
        displayValue$ = lpad$(hex$(value), 8, "0")
    else
        displayValue$ = lpad$(value, 8)
    end

    print right$(upper$(displayValue$), 8);

    blit
end

def performCounterAction action, arg
    if action = ACTION_INCREMENT
        counters[currentCounter].value = counters[currentCounter].value + arg
    else if action = ACTION_DECREMENT
        counters[currentCounter].value = counters[currentCounter].value - arg
    else if action = ACTION_SET_VALUE
        counters[currentCounter].value = arg
    else if action = ACTION_RESET
        counters[currentCounter].value = counters[currentCounter].resetValue
    else if action = ACTION_SET_RESET_VALUE
        counters[currentCounter].resetValue = counters[currentCounter].value
    end

    renderCounter

    saveCounters

    while key : loop
end

def openResetMenu
    noyes "Reset?", result

    if result
        counters[currentCounter].value = counters[currentCounter].resetValue

        saveCounters
    end
end

def openRenameInput
    input counters[currentCounter].name$, counters[currentCounter].name$

    saveCounters
end

def openActionSelectionMenu button$
    dim items with name$, action

    push "NONE", ACTION_NONE, items
    push "INCRMNT", ACTION_INCREMENT, items
    push "DECRMNT", ACTION_DECREMENT, items
    push "SET", ACTION_SET_VALUE, items
    push "RESET", ACTION_RESET, items
    push "SETRVAL", ACTION_SET_RESET_VALUE, items

    currentAction = ACTION_NONE

    if button$ = joysel
        currentAction = counters[currentCounter].selectAction
    else if button$ = joyup
        currentAction = counters[currentCounter].upAction
    else if button$ = joydown
        currentAction = counters[currentCounter].downAction
    end

    blinkvalue
    menu "Action?", items, i, find(items, "action", currentAction)

    if cancel
        return
    else if button$ = joysel
        counters[currentCounter].selectAction = items[i].action
    else if button$ = joyup
        counters[currentCounter].upAction = items[i].action
    else if button$ = joydown
        counters[currentCounter].downAction = items[i].action
    end

    saveCounters
end

def openButtonActionsMenu
    dim items with name$, button$

    push "SELECT", joysel, items
    push "UP", joyup, items
    push "DOWN", joydown, items

    i = 0

    menu "Button?", items, i

    if cancel
        return
    end

    openActionSelectionMenu items[i].button$
end

def openChangeBaseMenu
    dim items with name$, base

    push "2 (BIN)", 2, items
    push "8 (OCT)", 8, items
    push "10(DEN)", 10, items
    push "16(HEX)", 16, items

    blinkvalue
    menu "Base-n?", items, i, find(items, "base", counters[currentCounter].base)

    if not cancel
        counters[currentCounter].base = items[i].base

        saveCounters
    end
end

def openChangeResetValueMenu
    blinkvalue
    valuebase counters[currentCounter].base
    intinput "Rst val?", counters[currentCounter].resetValue, counters[currentCounter].resetValue

    saveCounters
end

def openDeleteMenu
    noyes "Delete?", result

    if result
        remove counters, currentCounter

        saveCounters
    end
end

def openCounterMenu
    dim items

    push "RESET", items
    push "RENAME", items
    push "AUTOCNT", items
    push "BTNACTS", items
    push "BASE-N", items
    push "CH RVAL", items
    push "DELETE", items
    push "+NEW", items

    i = 0

    menu counters[currentCounter].name$, items, i

    if cancel
        return
    else if items[i] = "RESET"
        openResetMenu
    else if items[i] = "RENAME"
        openRenameInput
    else if items[i] = "BTNACTS"
        openButtonActionsMenu
    else if items[i] = "BASE-N"
        openChangeBaseMenu
    else if items[i] = "CH RVAL"
        openChangeResetValueMenu
    else if items[i] = "DELETE"
        openDeleteMenu
    else if items[i] = "+NEW"
        newCounter "Counter"; len(counters) + 1, 0
    end
end

repeat
    if len(counters) = 0
        newCounter "Counter" 0
    end

    if currentCounter < 0
        currentCounter = len(counters) - 1
    end

    if currentCounter >= len(counters)
        currentCounter = 0
    end

    renderCounter

    if key = joysel
        performCounterAction counters[currentCounter].selectAction, counters[currentCounter].selectArg
    else if key = joyup
        performCounterAction counters[currentCounter].upAction, counters[currentCounter].upArg
    else if key = joydown
        performCounterAction counters[currentCounter].downAction, counters[currentCounter].downArg
    else if key = joyleft
        currentCounter = currentCounter - 1

        while key : loop
    else if key = joyright
        currentCounter = currentCounter + 1

        while key : loop
    else if key = joyback
        openCounterMenu
    end
loop