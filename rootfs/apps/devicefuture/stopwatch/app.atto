dim splitTimes

startTime = 0
stopTime = 0
running = false
timeIndex = 0
lastKey = ""
showSplit = false
showSplitChangeTime = -1000

def renderTime time, formatTime
    if formatTime < 10 * 60 * 1000
        dispMinutes$ = floor(time / 1000 / 60)
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")
        dispMilliseconds$ = lpad$(time mod 1000, 3, "0")

        print dispMinutes$; "'"; dispSeconds$; "\""; dispMilliseconds$;
    else if formatTime < 1 * 60 * 60 * 1000
        dispMinutes$ = lpad$(floor(time / 1000 / 60), 2, "0")
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")
        dispMilliseconds$ = lpad$(floor(time / 10) mod 100, 2, "0")

        print dispMinutes$; "'"; dispSeconds$; "\""; dispMilliseconds$;
    else if formatTime < 10 * 60 * 60 * 1000
        dispHours$ = floor(time / 1000 / 60 / 60)
        dispMinutes$ = lpad$(floor(time / 1000 / 60) mod 60, 2, "0")
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")

        print dispHours$; ":"; dispMinutes$; "'"; dispSeconds$; "\"";
    else
        dispHours$ = lpad$(floor(time / 1000 / 60 / 60) mod 24, 2, "0")
        dispMinutes$ = lpad$(floor(time / 1000 / 60) mod 60, 2, "0")
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")

        print dispHours$; ":"; dispMinutes$; ":"; dispSeconds$;
    end
end

repeat
    cls

    time = stopTime
    splitTimeIndex = timeIndex - 1
    currentKey = key
    lapSplitPrefix = "Lap "

    if showSplit
        lapSplitPrefix = "Split "
    end

    if running
        time = epoch - startTime
        splitTimeIndex = len(splitTimes) - 1
    end

    if running and len(splitTimes) > 0 and epoch - showSplitChangeTime < 1000
        print upper$(lapSplitPrefix); right$(len(splitTimes) + 1, 2);
        pos 0, 1
    else if len(splitTimes) > 0 and (running or timeIndex > 0)
        if not running
            print lapSplitPrefix; right$(timeIndex, 2);
            pos 0, 1
        end

        if splitTimeIndex > 0 and showSplit
            renderTime splitTimes[splitTimeIndex], time
        else if splitTimeIndex > 0
            renderTime splitTimes[splitTimeIndex] - splitTimes[splitTimeIndex - 1], time
        else
            renderTime splitTimes[0], time
        end

        pos 0, 1
    end

    if not running and len(splitTimes) > 0 and timeIndex <= 0
        if timeIndex = -1
            print lapSplitPrefix; right$(len(splitTimes) + 1, 2);
        else
            print "Total";
        end

        pos 0, 1
    end

    if running or timeIndex = -1 or (timeIndex = 0 and (stopTime = 0 or currentKey = joysel or epoch mod 1000 < 500))
        if not showSplit and (running or timeIndex = -1) and len(splitTimes) > 0
            renderTime time - splitTimes[len(splitTimes) - 1], time
        else
            renderTime time, time
        end
    end

    if not running and currentKey = joysel
        pos 0, 1
        print "--HOLD--";
    end

    blit

    if currentKey = joysel
        if running
            stopTime = time
            timeIndex = 0
        end

        while key : loop

        if not running
            startTime = epoch - stopTime

            if len(splitTimes) > 0
                showSplitChangeTime = epoch
            end
        end

        running = not running
    else if currentKey = joyback and not lastKey
        if running
            push epoch - startTime, splitTimes
        else
            startTime = epoch
            stopTime = 0

            dim splitTimes
        end
    else if currentKey = joyup and not lastKey
        timeIndex = timeIndex - 1
    else if currentKey = joydown and not lastKey
        timeIndex = timeIndex + 1
    else if (currentKey = joyleft or currentKey = joyright) and not lastKey
        showSplit = not showSplit
        showSplitChangeTime = epoch
    end

    if timeIndex < -1 or len(splitTimes) = 0
        timeIndex = len(splitTimes)
    else if timeIndex > len(splitTimes)
        timeIndex = -1
    end

    lastKey = currentKey
loop