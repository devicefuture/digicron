dim splitTimes

SHOW_SPLIT_CHANGE_DURATION = 1000

startTime = 0
stopTime = 0
running = false
displayTime = 0
splitIndex = 0
showSplit = false
showSplitChangeTime = -SHOW_SPLIT_CHANGE_DURATION
showTotal = true
lastKey = ""

def renderTime time
    timeFormat = min(time, displayTime)

    if timeFormat < 10 * 60 * 1000
        dispMinutes$ = floor(time / 1000 / 60)
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")
        dispMilliseconds$ = lpad$(time mod 1000, 3, "0")

        print dispMinutes$; "'"; dispSeconds$; "\""; dispMilliseconds$;
    else if timeFormat < 1 * 60 * 60 * 1000
        dispMinutes$ = lpad$(floor(time / 1000 / 60), 2, "0")
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")
        dispMilliseconds$ = lpad$(floor(time / 10) mod 100, 2, "0")

        print dispMinutes$; "'"; dispSeconds$; "\""; dispMilliseconds$;
    else if timeFormat < 10 * 60 * 60 * 1000
        dispHours$ = floor(time / 1000 / 60 / 60)
        dispMinutes$ = lpad$(floor(time / 1000 / 60) mod 60, 2, "0")
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")

        print dispHours$; ":"; dispMinutes$; "'"; dispSeconds$; "\"";
    else
        dispHours$ = lpad$(floor(time / 1000 / 60 / 60) mod 24, 2, "0")
        dispMinutes$ = lpad$(floor(time / 1000 / 60) mod 60, 2, "0")
        dispSeconds$ = lpad$(floor(time / 1000) mod 60, 2, "0")

        print dispHours$; ":"; dispMinutes$; ":"; dispSeconds$;
    end
end

def renderSplitMessage index, uppercase
    lapSplitPrefix = "Lap "

    if showSplit
        lapSplitPrefix = "Split "
    end

    if uppercase
        lapSplitPrefix = upper$(lapSplitPrefix)
    end

    print lapSplitPrefix; right$(index + 1, 2);
end

def renderSplitTime index
    if index > 0 and showSplit
        renderTime splitTimes[index]
    else if index > 0
        renderTime splitTimes[index] - splitTimes[index - 1]
    else
        renderTime splitTimes[0]
    end
end

def renderWithoutSplit
    cls
    pos 0, 0

    if running or displayTime = 0 or epoch mod 1000 < 500 or currentKey = joysel
        renderTime displayTime
    end
end

def renderRunningWithSplit
    cls
    pos 0, 0

    if epoch - showSplitChangeTime < SHOW_SPLIT_CHANGE_DURATION
        renderSplitMessage len(splitTimes), true
    else
        renderSplitTime len(splitTimes) - 1
    end

    pos 0, 1

    if not showSplit and len(splitTimes) > 0
        renderTime displayTime - splitTimes[len(splitTimes) - 1]
    else
        renderTime displayTime
    end
end

def renderStoppedSplit
    cls
    pos 0, 0
    renderSplitMessage splitIndex, false
    pos 0, 1
    renderSplitTime splitIndex

    if currentKey = joyup and not lastKey
        splitIndex = splitIndex - 1

        if splitIndex < 0
            splitIndex = len(splitTimes) - 1
            showTotal = true
        end
    else if currentKey = joydown and not lastKey
        splitIndex = splitIndex + 1
    end
end

def renderStoppedLastSplit
    cls
    pos 0, 0
    renderSplitMessage len(splitTimes), false
    pos 0, 1

    if showSplit
        renderTime displayTime
    else
        renderTime displayTime - splitTimes[len(splitTimes) - 1]
    end

    if currentKey = joyup and not lastKey
        splitIndex = len(splitTimes) - 1
    else if currentKey = joydown and not lastKey
        splitIndex = 0
        showTotal = true
    end
end

def renderStoppedTotal
    cls
    pos 0, 0
    print "Total"

    if epoch mod 1000 < 500 or currentKey = joysel
        renderTime stopTime
    end

    if currentKey = joyup and not lastKey
        splitIndex = len(splitTimes)
        showTotal = false
    else if currentKey = joydown and not lastKey
        splitIndex = 0
        showTotal = false
    end
end

repeat
    cls

    displayTime = stopTime
    currentKey = key

    if running
        displayTime = epoch - startTime
    end

    if len(splitTimes) = 0
        renderWithoutSplit
    else if len(splitTimes) > 0
        if running
            renderRunningWithSplit
        else if showTotal
            renderStoppedTotal
        else if splitIndex >= len(splitTimes)
            renderStoppedLastSplit
        else
            renderStoppedSplit
        end
    end

    if not running and currentKey = joysel
        pos 0, 1
        print "--HOLD--";
    end

    blit

    if currentKey = joysel
        while key = joysel : loop

        if running
            stopTime = displayTime
            showTotal = true
            splitIndex = 0
        else
            if key = joyback
                while key = joyback : loop
                continue
            end

            startTime = epoch - stopTime

            if len(splitTimes) > 0
                showSplitChangeTime = epoch
            end
        end

        running = not running
    else if currentKey = joyback and not lastKey
        if running
            push epoch - startTime, splitTimes
        else
            startTime = epoch
            stopTime = 0
            splitIndex = 0

            dim splitTimes
        end
    else if (currentKey = joyleft or currentKey = joyright) and len(splitTimes) > 0 and (running or not showTotal) and not lastKey
        showSplit = not showSplit
        showSplitChangeTime = epoch
    end

    lastKey = currentKey
loop