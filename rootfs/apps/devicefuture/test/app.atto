count = 0

def showMessage line1$, line2$
    resetScroll

    until key
        cls
        scroll line1$
        scroll line2$
        blit
    loop

    while key:loop
end

def test
    dim items
    push "First", items
    push "Second", items
    push "Third", items

    menu "Test", items, i

    if not cancel
        showMessage "Selected", "#"; i; ": "; items[i]
    else
        showMessage "Cancel", ""
    end
end

repeat
    cls
    print "Hello"
    print count
    blit

    if key = joysel
        test
    end

    count = count + 1
loop